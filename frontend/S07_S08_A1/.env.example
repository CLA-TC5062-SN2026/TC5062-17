# Desarrollo: Vite redirige /api al backend FastAPI.
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_REQUEST_TIMEOUT_MS=30000

# Producción con frontend y API en el mismo origen: conservar /api/v1.
# Producción con API en otro dominio: usar la URL absoluta.
# VITE_API_BASE_URL=https://api.mlstate.example/api/v1
